APP_ENV=development
MODEL_PATH=models/best.pt
# Optional; if set, must contain the exact class IDs/names used to train the checkpoint.
# DATASET_YAML=dataset/data.yaml
MODEL_DEVICE=cpu
MODEL_IMGSZ=640
CONFIDENCE_THRESHOLD=0.25
REQUIRE_MODEL=false

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=32000000
MAX_VIDEO_BYTES=209715200
MAX_VIDEO_DURATION_SECONDS=180
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
MAX_VIDEO_FRAMES=10800
VIDEO_FRAME_STRIDE=5
VIDEO_WORKERS=1
JOB_RETENTION_SECONDS=3600

# Optional for local inference. Production requires a reachable MongoDB database.
# MONGODB_URI=mongodb+srv://...
MONGODB_DATABASE=safesight
REQUIRE_DATABASE=false

# Local mode uses a single development identity. For production, use a trusted
# OIDC issuer/JWKS (for example the separate frontend's Clerk tenant) and include
# a verified workplace_id custom claim in its signed access token.
AUTH_MODE=disabled
# AUTH_ISSUER=https://your-tenant.example
# AUTH_JWKS_URL=https://your-tenant.example/.well-known/jwks.json
# AUTH_AUDIENCE=
AUTH_WORKPLACE_CLAIM=workplace_id

# Comma-separated exact frontend origins; empty means no browser origins are allowed.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=60

# Optional private S3-compatible storage. The bucket must not allow public access.
# Credentials are read from the standard AWS SDK credential chain.
# S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT_URL=
S3_PREFIX=safesight/evidence
